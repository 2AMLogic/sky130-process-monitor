{
  "schema_version": 1,
  "kind": "t1-attestation-inventory",
  "t1_item": 9,
  "description": "Analog partition testbenches: every committed SPICE deck behind a recorded analog measurement, plus every committed `klt sim` request that drives one. Cold starts are bounded by construction and do NOT re-run the multi-hour batch-fleet grids: the oscillator-bank and smoke decks run their real single-corner `ngspice -b` locally (--no-record, so a repeat appends nothing to the append-only records), and every `klt sim` request is validated with `--dry-run` (deck staging, model resolution, corner/Monte-Carlo expansion against the pinned PDK) rather than simulated. The full fleet invocation for each grid is documented in that bench's README and in manifests/README.md; it is not executed by this attestation.",
  "cold_start": {
    "argv": [
      "sim/check_env.sh"
    ],
    "cwd": ".",
    "local_only": true,
    "timeout_s": 300
  },
