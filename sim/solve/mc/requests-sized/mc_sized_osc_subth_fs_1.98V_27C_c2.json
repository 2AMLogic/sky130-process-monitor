{
  "netlist": "../../../sensitivity/osc/tb_osc_subth.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "analysis": {
    "kind": "tran",
    "args": "10n 500u"
  },
  "measurements": [
    {
      "name": "t_rise",
      "unit": "s",
      "crossings": {
        "signal": "v(out)",
        "level": {
          "frac_of": "vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 400
      }
    }
  ],
  "options": {
    "timeout_s": 300,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "units": [
      {
        "process": "fs",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.98
        }
      }
    ]
  },
  "monte_carlo": {
    "n": 50,
    "seed": 20263106,
    "vary": "mismatch",
    "mismatch_scale": 1,
    "seed_scope": "point"
  }
}
