{
 "netlist": "../osc/tb_osc_wire_probe.spice",
 "engine": "ngspice",
 "models": {
  "pdk": "sky130A",
  "lib": "libs.tech/ngspice/sky130.lib.spice"
 },
 "analysis": {
  "kind": "tran",
  "args": "50p 2.5u 0 20p"
 },
 "measurements": [
  {
   "name": "t_rise",
   "unit": "s",
   "crossings": {
    "signal": "v(out)",
    "level": {
     "frac_of": "vdd",
     "fraction": 0.5
    },
    "edge": "rise",
    "max": 400
   }
  }
 ],
 "options": {
  "timeout_s": 3000,
  "retry_on_convergence_error": true
 },
 "batch": {
  "job_ceiling_check": "warn"
 },
 "backend": "batch",
 "corners": {
  "units": [
   {
    "process": "tt",
    "temperature_c": -40,
    "supply_v": {
     "vdd": 1.98
    }
   },
   {
    "process": "sf",
    "temperature_c": -40,
    "supply_v": {
     "vdd": 1.8
    }
   },
   {
    "process": "ss",
    "temperature_c": -40,
    "supply_v": {
     "vdd": 1.98
    }
   }
  ]
 }
}