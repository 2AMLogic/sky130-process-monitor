{
  "netlist": "../osc/tb_osc_subth.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "analysis": {
    "kind": "tran",
    "args": "20n 2m"
  },
  "measurements": [
    {
      "name": "t_rise",
      "unit": "s",
      "crossings": {
        "signal": "v(out)",
        "level": {
          "frac_of": "vdd",
          "fraction": 0.5
        },
        "edge": "rise",
        "max": 400
      }
    }
  ],
  "options": {
    "timeout_s": 3000,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "process": [
      "tt",
      "ff",
      "ss",
      "sf",
      "fs"
    ],
    "supply_v": {
      "vdd": [
        1.62,
        1.8,
        1.98
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  }
}
