{
  "netlist": "../tb/xcheck_settle_osc_wire_shunt13.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "options": {
    "timeout_s": 3000,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "units": [
      {
        "process": "ss",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "ss",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.8
        }
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "10n 5000n"
  },
  "measurements": [
    {
      "name": "i_vdd",
      "spice": ".meas tran i_vdd avg i(Vdd) from=2500n to=5000n",
      "unit": "A"
    }
  ]
}
