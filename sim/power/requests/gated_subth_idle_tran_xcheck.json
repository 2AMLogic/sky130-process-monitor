{
  "netlist": "../tb/gated_subth_idle_tran.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "options": {
    "timeout_s": 3000,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "units": [
      {
        "process": "tt",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.8
        }
      },
      {
        "process": "tt",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "tt",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "ff",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "ff",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.8
        }
      },
      {
        "process": "ff",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "ss",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "ss",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.8
        }
      },
      {
        "process": "ss",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "sf",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "sf",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.8
        }
      },
      {
        "process": "sf",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "fs",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.62
        }
      },
      {
        "process": "fs",
        "temperature_c": 27,
        "supply_v": {
          "vdd": 1.8
        }
      },
      {
        "process": "fs",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "10n 500000n"
  },
  "measurements": [
    {
      "name": "i_vdd",
      "spice": ".meas tran i_vdd avg i(Vdd) from=250000n to=500000n",
      "unit": "A"
    },
    {
      "name": "vbp_f",
      "spice": ".meas tran vbp_f find v(xdut.vbp) at=500000n",
      "unit": "V"
    }
  ]
}
