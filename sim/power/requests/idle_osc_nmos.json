{
  "netlist": "../tb/idle_osc_nmos.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "options": {
    "timeout_s": 3000,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "process": [
      "tt",
      "ff",
      "ss",
      "sf",
      "fs"
    ],
    "supply_v": {
      "vdd": [
        1.62,
        1.8,
        1.98
      ]
    },
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "op",
    "args": ""
  },
  "measurements": [
    {
      "name": "i_vdd",
      "expr": "i(Vdd)",
      "unit": "A"
    }
  ]
}
