{
  "netlist": "../tb/probe_off_devices.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "options": {
    "timeout_s": 3000,
    "retry_on_convergence_error": true
  },
  "batch": {
    "job_ceiling_check": "warn"
  },
  "backend": "batch",
  "corners": {
    "units": [
      {
        "process": "fs",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "ff",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "ss",
        "temperature_c": 125,
        "supply_v": {
          "vdd": 1.98
        }
      },
      {
        "process": "fs",
        "temperature_c": -40,
        "supply_v": {
          "vdd": 1.98
        }
      }
    ]
  },
  "analysis": {
    "kind": "op",
    "args": ""
  },
  "measurements": [
    {
      "name": "i_p_wire_stage",
      "expr": "i(Vm_p_wire_stage)",
      "unit": "A"
    },
    {
      "name": "i_p_nmos_stage",
      "expr": "i(Vm_p_nmos_stage)",
      "unit": "A"
    },
    {
      "name": "i_p_subth_stage",
      "expr": "i(Vm_p_subth_stage)",
      "unit": "A"
    },
    {
      "name": "i_p_subth_lvt",
      "expr": "i(Vm_p_subth_lvt)",
      "unit": "A"
    },
    {
      "name": "i_n_stage",
      "expr": "i(Vm_n_stage)",
      "unit": "A"
    },
    {
      "name": "i_n_enstack",
      "expr": "i(Vm_n_enstack)",
      "unit": "A"
    },
    {
      "name": "i_n_long",
      "expr": "i(Vm_n_long)",
      "unit": "A"
    },
    {
      "name": "i_n_gate_switch",
      "expr": "i(Vm_n_gate_switch)",
      "unit": "A"
    }
  ]
}
