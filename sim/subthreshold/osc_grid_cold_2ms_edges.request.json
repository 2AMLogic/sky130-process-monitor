{
  "netlist": "osc_subth_tb.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "sky130A",
    "lib": "libs.tech/ngspice/sky130.lib.spice"
  },
  "corners": {
    "units": [
      {
        "process": "ss",
        "supply_v": {
          "vdd": 1.62
        },
        "temperature_c": -40
      },
      {
        "process": "ss",
        "supply_v": {
          "vdd": 1.8
        },
        "temperature_c": -40
      },
      {
        "process": "sf",
        "supply_v": {
          "vdd": 1.62
        },
        "temperature_c": -40
      },
      {
        "process": "sf",
        "supply_v": {
          "vdd": 1.8
        },
        "temperature_c": -40
      },
      {
        "process": "sf",
        "supply_v": {
          "vdd": 1.98
        },
        "temperature_c": -40
      }
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "5n 2m"
  },
  "measurements": [
    {
      "name": "t_e1",
      "spice": ".meas tran t_e1 when v(out)=0.9 rise=1",
      "unit": "s"
    },
    {
      "name": "t_e2",
      "spice": ".meas tran t_e2 when v(out)=0.9 rise=2",
      "unit": "s"
    },
    {
      "name": "v_max",
      "spice": ".meas tran v_max max v(out) from=100u to=2m",
      "unit": "V"
    },
    {
      "name": "v_min",
      "spice": ".meas tran v_min min v(out) from=100u to=2m",
      "unit": "V"
    }
  ],
  "options": {
    "timeout_s": 3600,
    "keep_artifacts": false
  }
}
